{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["skcompass"],
  "ios": {
    "iosModuleName": "NitroSkCompass"
  },
  "android": {
    "androidNamespace": ["skcompass"],
    "androidCxxLibName": "NitroSkCompass"
  },
  "autolinking": {
    "Compass": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridSkMath"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridSkMath"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
